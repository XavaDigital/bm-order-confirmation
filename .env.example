# Copy to .env.local for development. NEVER commit real secrets.

# --- Database (Supabase Postgres or any Postgres) ---
# DATABASE_URL: pooled connection (port 6543) used by the app at runtime.
# DATABASE_DIRECT_URL: direct connection (port 5432) used by drizzle-kit for DDL migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres"
DATABASE_DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# --- App ---
# Public base URL used to build customer confirmation links: {APP_BASE_URL}/o/{token}
APP_BASE_URL="http://localhost:3000"

# Secret pepper mixed into the token hash before storage. Generate a long random value.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_PEPPER="change-me-to-a-long-random-string"

# --- Internal service auth (the /api/orders ingestion seam, see PROJECT_BRIEF.md §15) ---
# Shared secret the admin UI / future sales platform sends as x-api-key. Stub for now.
INTERNAL_API_KEY="change-me-internal-api-key"

# --- Staff session (iron-session encrypted cookie) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- First admin user (used by npm run db:seed only — never commit real values) ---
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Admin"

# --- Scheduled jobs (see README §6) ---
# Recurring work (outbox delivery, housekeeping) runs IN-PROCESS — no external
# scheduler required. Set this to 1 only if something else drives the internal
# endpoints and you want to avoid double-running.
SCHEDULER_DISABLED=""
# Bearer token for an external scheduler hitting /api/internal/** (optional —
# those endpoints also accept `x-api-key: $INTERNAL_API_KEY`).
CRON_SECRET=""

# --- Customer magic-link expiry (optional) ---
# Days a magic link stays valid after creation. Leave unset for links that never expire.
# Suggested value once enabled: 30. Staff can always mint a fresh link via "Resend link".
LINK_EXPIRY_DAYS=""

# --- File storage (S3-compatible, e.g. Supabase Storage) ---
# Uploads fail gracefully if unset — configure before going live.
# Supabase Storage: create a private bucket, then Storage > Settings > S3 for
# the endpoint (https://<project-ref>.storage.supabase.co/storage/v1/s3),
# region, and access keys. AWS_S3_REGION must match or presigned URLs 403.
# Swapping to real AWS S3 later (fleet shared bucket): change these values
# and leave AWS_S3_ENDPOINT empty — no code change needed.
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_S3_ACCESS_KEY=""
AWS_S3_SECRET_ACCESS_KEY=""
# Only for non-AWS providers; leave empty for real AWS S3.
AWS_S3_ENDPOINT=""

# --- Email (SMTP) ---
# Leave SMTP_HOST unset to disable email (links must be shared manually).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"          # true = TLS (port 465); false = STARTTLS (port 587)
MAIL_FROM="orders@example.com"
STAFF_NOTIFICATIONS_CC=""   # Optional team inbox CC for staff notification emails

# --- Google Tag Manager (client-side conversion tracking — see PROJECT_BRIEF.md §10) ---
# Get from GTM > Admin > Container Settings. Leave empty to disable GTM injection.
NEXT_PUBLIC_GTM_ID=""

# --- Google Ads Enhanced Conversions (client-side GTM tag params) ---
GOOGLE_ADS_CONVERSION_ID=""
GOOGLE_ADS_CONVERSION_LABEL=""

# --- Google Ads Enhanced Conversions (server-side API upload) ---
# All six must be set together; leave any unset to disable server-side firing.
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_CONVERSION_ACTION_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_OAUTH_CLIENT_ID=""
GOOGLE_ADS_OAUTH_CLIENT_SECRET=""
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=""

# --- Error monitoring (optional) ---
# src/lib/logger.ts sends logger.error() calls to Sentry's envelope ingestion
# API when set (plain fetch, no SDK). Leave unset to disable — errors still
# log to stdout as structured JSON either way.
SENTRY_DSN=""

# --- Sales Hub (bm-sales) fleet integration — all optional, unset = dormant ---
# Outbound: the hub's Capability API (docs: bm-sales/docs/capability-api.md).
# CAPABILITY_API_SECRET is the SHARED fleet capability bearer (Secret Manager:
# bm-sales-capability-api-secret).
CAPABILITY_API_URL=""
CAPABILITY_API_SECRET=""
# Inbound: the per-app secret the hub / Email Flow presents when calling this
# app's /api/capability/v1/* routes. Keep distinct from the two above.
INBOUND_CAPABILITY_SECRET=""

# --- bm-identity (fleet identity service) — optional, unset = dormant ---
# Google SSO delegation and per-app access grants. While unset, password login
# is the only way in and nothing here is consulted.
#
# Onboarding needs FOUR things from the identity service, none of which this
# app can generate for itself:
#   1. a row in the identity `apps` registry, keyed by IDENTITY_APP_ID below
#      (choose once — it is the grants key forever);
#   2. the Google OAuth client id registered against that row (logins are
#      verified against the CALLING app's client id);
#   3. that app's default domain role (`auto_grant_domain_role`), which decides
#      what a @beastmode person gets without an explicit grant;
#   4. the per-app bearer secret, handed over out-of-band (Secret Manager:
#      bm-identity-secret-<app>). This is a FOURTH credential — never the
#      shared CAPABILITY_API_SECRET and never the inbound one.
IDENTITY_API_URL=""
IDENTITY_API_SECRET=""
IDENTITY_APP_ID="order-confirmation"
